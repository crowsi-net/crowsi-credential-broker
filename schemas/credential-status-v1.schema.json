{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crowsi://credentials/status/v1",
  "title": "Crowsi credential status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "external_actions",
    "contains_secret_values",
    "credential_count",
    "credentials"
  ],
  "properties": {
    "schema": { "const": "crowsi://credentials/status/v1" },
    "generated_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 253402300799
    },
    "external_actions": { "const": false },
    "contains_secret_values": { "const": false },
    "credential_count": { "type": "integer", "minimum": 0, "maximum": 1024 },
    "credentials": {
      "type": "array",
      "description": "Credential id values MUST be unique within the document.",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/credential" }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant", "service", "audience"],
      "properties": {
        "tenant": { "$ref": "#/$defs/component64" },
        "service": { "$ref": "#/$defs/component64" },
        "audience": { "$ref": "#/$defs/component96" }
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "provider",
        "purpose",
        "status",
        "store_kind",
        "scope",
        "checked_at",
        "expires_at",
        "rotation_due_at",
        "finding_codes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 5,
          "maxLength": 420,
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]+$"
        },
        "provider": { "$ref": "#/$defs/component64" },
        "purpose": { "$ref": "#/$defs/component96" },
        "status": {
          "description": "Only ready is currently emitted. expired, revoked, and unavailable are reserved for evidence-backed factories.",
          "enum": ["ready", "expired", "revoked", "unavailable"]
        },
        "store_kind": { "$ref": "#/$defs/component64" },
        "scope": { "$ref": "#/$defs/scope" },
        "checked_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        },
        "expires_at": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 253402300799
        },
        "rotation_due_at": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 253402300799
        },
        "finding_codes": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9._-]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "component64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "component96": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9._-]+$"
    }
  }
}
