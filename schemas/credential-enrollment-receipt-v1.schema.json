{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crowsi://credentials/ipc/enrollment-receipt/v1",
  "title": "Crowsi credential enrollment receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "reservation_id",
    "credential_ref",
    "store_kind",
    "status",
    "contains_secret_values"
  ],
  "properties": {
    "schema": {
      "const": "crowsi://credentials/ipc/enrollment-receipt/v1"
    },
    "request_id": { "$ref": "#/$defs/component96" },
    "reservation_id": { "$ref": "#/$defs/component128" },
    "credential_ref": {
      "type": "string",
      "minLength": 5,
      "maxLength": 420,
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "store_kind": { "$ref": "#/$defs/component64" },
    "status": { "const": "ready" },
    "contains_secret_values": { "const": false }
  },
  "$defs": {
    "component64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "component96": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "component128": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    }
  }
}
