{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crowsi://credentials/reference/v1",
  "title": "Crowsi credential reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "scope"],
  "properties": {
    "id": { "$ref": "#/$defs/component96" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant", "service", "purpose", "audience"],
      "properties": {
        "tenant": { "$ref": "#/$defs/component64" },
        "service": { "$ref": "#/$defs/component64" },
        "purpose": { "$ref": "#/$defs/component96" },
        "audience": { "$ref": "#/$defs/component96" }
      }
    }
  },
  "$defs": {
    "component64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "component96": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9._-]+$"
    }
  }
}
