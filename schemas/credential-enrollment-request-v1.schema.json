{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crowsi://credentials/ipc/enrollment-request/v1",
  "title": "Crowsi authenticated credential enrollment request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "credential",
    "label",
    "provider",
    "allowed_hosts",
    "secret_length",
    "secret_sha256"
  ],
  "properties": {
    "schema": {
      "const": "crowsi://credentials/ipc/enrollment-request/v1"
    },
    "request_id": { "$ref": "#/$defs/component96" },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tenant", "service", "purpose", "audience"],
      "properties": {
        "id": { "$ref": "#/$defs/component96" },
        "tenant": { "$ref": "#/$defs/component64" },
        "service": { "$ref": "#/$defs/component64" },
        "purpose": { "$ref": "#/$defs/component96" },
        "audience": { "$ref": "#/$defs/component96" }
      }
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "provider": { "$ref": "#/$defs/component64" },
    "allowed_hosts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253
      }
    },
    "secret_length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "secret_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "component64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "component96": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9._-]+$"
    }
  }
}
